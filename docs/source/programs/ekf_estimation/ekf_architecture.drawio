<mxfile host="app.diagrams.net">
  <diagram name="Page-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="ref" value="reference&#10;trajectory" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="20" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="sum" value="" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="445" y="95" width="30" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="pid" value="cascade PID" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="145" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="alloc" value="control&#10;allocation" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="250" width="120" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="plant" value="plant" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="350" width="80" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="sens" value="GPS, IMU,&#10;magnetometer" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="120" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="ekf" value="EKF" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="predict" value="predict" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="125" y="245" width="70" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="correct" value="correct" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="180" width="70" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" source="ref" target="sum" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" source="sum" target="pid" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" source="pid" target="alloc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" source="alloc" target="plant" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" source="plant" target="sens" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" source="sens" target="correct" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" source="correct" target="predict" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" edge="1" source="predict" target="sum" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" source="alloc" target="predict" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
